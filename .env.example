# Local defaults: SQLite and disk photos. Copy this file to .env.local.
PORT=3001
DATABASE_PATH=./data/civicsignal.db
UPLOAD_DIR=./uploads
APP_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=14

# Public project configuration supplied for this mission.
# Kept server-side: this Vite app uses the Express API, not Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=https://zocubotkhlkrtbyyheiu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CxOPt-EZ2FJU6Za01tiA6A_lT3AuWHb

# Production: set real values in Vercel's environment settings, never source control.
# CONNECTION_STRING=copy the Supabase Postgres connection string, with password and SSL
# PHOTO_STORAGE=supabase
# SUPABASE_SECRET_KEY=server-only key from Supabase Settings > API Keys
# SUPABASE_PHOTO_BUCKET=civicsignal-photos

# Existing Postgres + Vercel Blob deployments remain supported instead:
# PHOTO_STORAGE=blob
# BLOB_READ_WRITE_TOKEN=server-only Vercel Blob token
