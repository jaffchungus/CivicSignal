# Local defaults: SQLite and disk photos. Copy this file to .env.local.
PORT=3001
DATABASE_PATH=./data/civicsignal.db
UPLOAD_DIR=./uploads
APP_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=14

# Optional server-side Gemini API key. Photo suggestions turn on automatically when set.
# Never expose the API key as VITE_* or NEXT_PUBLIC_*.
# GEMINI_API_KEY=key-from-google-ai-studio
# Optional emergency switch to turn off photo suggestions even when a key is set:
# DISABLE_GEMINI_PHOTO_ANALYSIS=true

# Optional Supabase project configuration for server-side database/storage use.
# These are placeholders; this Vite app uses Express sessions, not Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Production: set real values in Vercel's environment settings, never source control.
# DB_PASSWORD=database-password-for-the-Supabase-direct-host-below
# Or provide a full connection URL; it takes precedence over DB_PASSWORD:
# CONNECTION_STRING=postgresql://postgres:encoded-password@db.zocubotkhlkrtbyyheiu.supabase.co:5432/postgres?sslmode=require
# PHOTO_STORAGE=supabase
# SUPABASE_SECRET_KEY=server-only key from Supabase Settings > API Keys
# SUPABASE_PHOTO_BUCKET=civicsignal-photos

# Optional external photo providers. Without either provider's credentials,
# production stores private photo bytes in the Postgres report_photos table.
# PHOTO_STORAGE=blob
# BLOB_READ_WRITE_TOKEN=server-only Vercel Blob token
# The connected Vercel Blob store must be configured as private.
# PHOTO_STORAGE=database

# Optional address lookup override. Defaults to the Nominatim reverse endpoint.
# REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# Contact information used to identify CivicSignal to the address lookup provider.
# REVERSE_GEOCODER_CONTACT=mailto:operator@example.org
# When changing providers, also set its public name, attribution, and policy link.
# REVERSE_GEOCODER_NAME=Address lookup service
# REVERSE_GEOCODER_ATTRIBUTION=Provider attribution
# REVERSE_GEOCODER_ATTRIBUTION_URL=https://provider.example/attribution
# REVERSE_GEOCODER_POLICY_URL=https://provider.example/terms
# REVERSE_GEOCODER_USAGE_NOTE=Location lookup usage note

# Optional Web Push VAPID key pair. If omitted, CivicSignal generates and stores
# a persistent pair in the configured database. Set WEB_PUSH_SUBJECT to a real
# operator URL or contact email for production deployments.
# WEB_PUSH_VAPID_PUBLIC_KEY=base64url-public-key
# WEB_PUSH_VAPID_PRIVATE_KEY=base64url-private-key
# WEB_PUSH_SUBJECT=mailto:operator@example.org
