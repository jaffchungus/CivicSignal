+  padding: 1rem 1.4rem;
+  color: var(--forest-950);
+  font-weight: 700;
+}
+
+.impact-panel > summary .muted {
+  font-size: 0.82rem;
+  font-weight: 400;
+}
+
+.impact-panel[open] > summary {
+  border-bottom: 1px solid var(--line);
+}
+
+.impact-panel > :not(summary) {
+  margin-right: 1.4rem;
+  margin-left: 1.4rem;
+}
+
+.impact-panel > :last-child {
+  margin-bottom: 1.4rem;
+}
+
+.setup-checklist {
+  border-left: 4px solid var(--forest-700);
+}
+
+.setup-checklist h2 {
+  margin-top: 0;
+}
+
+.setup-checklist ul {
+  padding-left: 1.2rem;
+}
+
+.setup-checklist li + li {
+  margin-top: 0.35rem;
+}
+
+.routing-note,
+.routing-disclosure {
+  padding: 0.8rem 1rem;
+  border-left: 3px solid #8ea99a;
+  background: #f1f6f2;
+  color: #334c40;
+  font-size: 0.9rem;
+  line-height: 1.5;
+}
+
+.routing-note {
+  margin: 0;
+}
+
+.resident-follow-up.needs-attention {
+  padding: 1rem;
+  border: 1px solid #dfb56d;
+  border-radius: 9px;
+  background: #fffaf0;
+}
+
+.follow-up-alert {
+  padding: 0.7rem 0.85rem;
+  border-left: 3px solid #bd8219;
+  background: #fbf1dc;
+  color: #553b12;
+  font-weight: 620;
+}
+
+.confirmation-buttons {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.55rem;
+  margin-top: 0.65rem;
+}
+
+.photo-selected {
+  display: flex;
+  align-items: flex-end;
+  flex-wrap: wrap;
+  gap: 0.6rem;
+  margin-top: 0.6rem;
+}
+
+.photo-selected .link-button {
+  min-height: 44px;
+}
+
+.pill {
+  display: inline-flex;
+  min-height: 26px;
+  align-items: center;
+  padding: 0.15rem 0.55rem;
+  border: 1px solid #b9d4c3;
+  border-radius: 999px;
+  background: #e8f3ec;
+  color: #245d42;
+  font-size: 0.74rem;
+  font-weight: 720;
+  white-space: nowrap;
+}
+
+.topnav a {
+  min-height: 44px;
+}
+
+.link-button {
+  min-height: 44px;
+}
+
+.detail .back-link {
+  min-height: 44px;
+}
+
+.map-control-button {
+  min-height: 44px;
+}
+
+@media (max-width: 760px) {
+  .topnav {
+    flex-wrap: wrap;
+    overflow-x: visible;
+    row-gap: 0.1rem;
+    padding-bottom: 0.15rem;
+  }
+
+  .topnav > * {
+    flex: 0 0 auto;
+  }
+
+  .topnav a,
+  .topnav .link-button {
+    min-height: 44px;
+  }
+
+  .report-row-badges {
+    justify-content: flex-start;
+  }
+
+  .section-heading {
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 0.15rem;
+  }
+}
+
+@media (max-width: 480px) {
+  .impact-panel > summary {
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 0.15rem;
+  }
+
+  .filter-chip {
+    flex: 1 1 140px;
+  }
+}
